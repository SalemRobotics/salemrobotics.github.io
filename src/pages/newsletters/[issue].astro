---
import fs from "node:fs/promises";
import path from "node:path";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const newsletterDir = path.join(process.cwd(), "src", "newsletter");
  const files = await fs.readdir(newsletterDir);

  const jsonFiles = files.filter((f) => f.endsWith(".json"));

  return await Promise.all(
    jsonFiles.map(async (file) => {
      const slug = file.replace(".json", "");

      const metadata = JSON.parse(
        await fs.readFile(path.join(newsletterDir, file), "utf8"),
      );

      return {
        params: { issue: slug },
        props: {
          slug,
          metadata,
        },
      };
    }),
  );
}

const { slug, metadata } = Astro.props;

// This imports the PDF as an asset.
const pdfModules = import.meta.glob("@/newsletter/*.pdf", {
  eager: true,
  import: "default",
});

const pdfUrl = `/newsletters/${slug}.pdf`;
---

<Layout title="" description="">
  <h1>{metadata.title}</h1>

  <p>{metadata.description}</p>

  <p>
    <a href={pdfUrl}>Download PDF</a>
  </p>

  <iframe src={pdfUrl} width="100%" height="1000"></iframe>
</Layout>
