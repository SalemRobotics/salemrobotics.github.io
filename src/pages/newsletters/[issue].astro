---
import fs from "node:fs/promises";
import path from "node:path";
import Layout from "@/layouts/Layout.astro";
import { getNewsletterEditions } from "@/newsletter.ts";

export async function getStaticPaths() {
  const editions = await getNewsletterEditions();

  return editions.map((edition) => {
    const { filePath, title, description } = edition;

    return {
      params: { issue: filePath },
      props: {
        slug: filePath,
        metadata: {
          title,
          description,
        },
      },
    };
  });
}

const { slug, metadata } = Astro.props;
const pdfUrl = `/newsletters/${slug}.pdf`;

const pdfPath = path.join(
  process.cwd(),
  "public",
  "newsletters",
  `${slug}.pdf`,
);

const { size: pdfSize } = await fs.stat(pdfPath);
const pdfSizeMB = (pdfSize / 1024 / 1024).toFixed(1);
---

<Layout title={metadata.title} description={metadata.description}>
  <div id="desc-container" class="oswald-text">
    <h1 id="newsletter-title">{metadata.title}</h1>
    <p id="newsletter-desc" set:html={metadata.description} />
    <button>
      <p>
        <a href={pdfUrl} download>
          Download this edition as a PDF ({pdfSizeMB} MB)
        </a>
      </p>
    </button>
  </div>
  <div id="newsletter-view">
    <iframe src={pdfUrl} width="100%" height="100%"></iframe>
  </div>
  <style>
    :global(html) {
      scroll-snap-type: y mandatory;
      scroll-padding-top: 10vh;
    }
    :global(footer) {
      scroll-snap-align: end;
    }
    #desc-container {
      scroll-snap-align: center;
      margin-bottom: 5vh;
      padding-left: 5%;
    }
    #newsletter-view {
      scroll-snap-align: center;
      width: 100%;
      height: 90vh;
    }
  </style>
</Layout>
