---
import fs from "node:fs/promises";
import path from "node:path";
import Layout from "@/layouts/Layout.astro";
import { getNewsletterEditions } from "@/newsletter.ts";

export async function getStaticPaths() {
  const editions = await getNewsletterEditions();

  return editions.map((edition) => {
    const { filePath, title, description } = edition;
    
    return {
      params: { issue: filePath },
      props: {
        slug: filePath,
        metadata: {
          title,
          description
        }
      }
    }
  });
}

const { slug, metadata } = Astro.props;
const pdfUrl = `/newsletters/${slug}.pdf`;
---

<Layout title={metadata.title} description={metadata.description}>
  <div id="desc-container">
    <h1 id="newsletter-title">{metadata.title}</h1>
    <p id="newsletter-desc">{metadata.description}</p>
    <button>
      <p>
        <a href={pdfUrl}>
          Download as a PDF
        </a>
      </p>
    </button>
  </div>
  <div id="newsletter-view">
    <iframe src={pdfUrl} width="100%" height="100%"></iframe>
  </div>
  <style>
    :global(html) {
      scroll-snap-type: y mandatory;
    }
    :global(footer) {
      scroll-snap-align: end;
    }
    #desc-container {
      scroll-snap-align: center;
      min-height: 50vh;
    }
    #newsletter-view {
      scroll-snap-align: center;
      width: 100%;
      height: 90vh;
    }
  </style>
</Layout>
