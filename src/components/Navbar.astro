---
interface Props {
  pageSelected?: string;
}

const props = Astro.props;

/**
 * Checks if the navbar option is the currently shown page. This allows the browser to save itself
 * work if the user clicks on a link to the current page by preventing a full reload.
 *
 * @param page The page to check against.
 * @returns The top of the current page if it is the currently selected option, otherwise returns `page`.
 */
function isSelected(page: string): string {
  if (props.pageSelected === page) {
    return "#";
  }

  return `/${page}`;
}
---

<!-- TODO: Add line animation under hovered links -->
<header id="navbar-header" role="banner" aria-label="Page Header">
  <nav id="navbar">
    <div id="navbar-title-container">
      <h1 id="navbar-title">
        <a
          id="navbar-title-anchor"
          href={isSelected("")}
          class="devil-bauer bd-blue"
        >
          The Blue Devils
        </a>
        <script is:inline>
          const link = document.getElementById("navbar-title-anchor");
          const currentMonth = new Date().getMonth();

          /* Month is zero-based; June (as the sixth month) is 5. */
          if (currentMonth == 5) {
            link.classList.remove("bd-blue");
            link.classList.add("progress-flag-text");
          }
        </script>
      </h1>
    </div>
    <ul id="navbar-links" class="oswald-text">
      <li class="navbar-dropdown">
        <a
          class="navbar-dropdown-trigger hover-blue"
          href={isSelected("about-us")}
        >
          About Us
        </a>
        <ul class="navbar-dropdown-menu">
          <li><a href={isSelected("about-us/jabs")} class="hover-blue">History</a></li>
          <li><a href={isSelected("about-us/outreach")} class="hover-blue">Outreach</a></li>
          <li><a href={isSelected("about-us/updates")} class="hover-blue">Updates</a></li>
        </ul>
      </li>
      <li class="navbar-dropdown">
        <a class="navbar-dropdown-trigger hover-blue" href={isSelected("seasons")}>
          Seasons
        </a>
        <ul class="navbar-dropdown-menu">
          <li><a href={isSelected("seasons/2026")} class="hover-blue">2026</a></li>
          <li><a href={isSelected("seasons/2025")} class="hover-blue">2025</a></li>
        </ul>
      </li>
      <li>
        <a href={isSelected("donate")} class="hover-blue">
          Support Us
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .hover-blue {
    transition: color 0.4s ease-in-out;
  }

  .hover-blue:hover,
  .hover-blue:focus-within {
    color: var(--bd-blue) !important;
  }

  #navbar-header {
    position: sticky;
    top: 0;
    width: 100%;
    height: fit-content;
    z-index: 5000;

    background-color: #b3b3b3;
  }

  #navbar {
    width: 100%;
    display: flex;
    flex-direction: row;
    height: 10vh;
    align-items: center;

    & h1 {
      margin: 0;
    }

    & a {
      text-decoration: none;
    }
  }

  #navbar-title-container {
    width: 35%;
    display: flex;
    justify-content: center;
    align-items: center;

    & h1 {
      display: flex;
    }
  }

  #navbar-links {
    width: 65%;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    list-style: none;
    padding: 0;
    margin: 0;

    & > li > a {
      color: black;
      font-size: 1.65rem;
      font-weight: bold;
    }
  }

  .navbar-dropdown {
    position: relative;
  }

  .navbar-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: black;
    text-decoration: none;

    &::after {
      width: 0.45rem;
      height: 0.45rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      content: "";
      transform: translateY(-0.12rem) rotate(45deg);
      transition: transform 0.3s ease-in-out;
    }

    &:focus-visible {
      outline: 3px solid var(--bd-blue);
      outline-offset: 4px;
      border-radius: 2px;
    }
  }

  .navbar-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1;
    min-width: 10rem;
    margin: 0;
    padding: 0;
    list-style: none;
    background: white;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 18%);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.25rem);
    transition:
      opacity 0.2s ease-in-out,
      transform 0.2s ease-in-out,
      visibility 0.2s ease-in-out;

    & a {
      display: block;
      padding: 0.65rem 1rem;
      color: black;
      font-size: 1.2rem;
      text-decoration: none;
      white-space: nowrap;
      transition:
        color 0.2s ease-in-out,
        background-color 0.2s ease-in-out;
    }

    & a:hover,
    & a:focus-visible {
      background-color: #f0f3fa;
    }

    & a:focus-visible {
      outline: 3px solid var(--bd-blue);
      outline-offset: -3px;
    }
  }

  .navbar-dropdown:hover .navbar-dropdown-menu,
  .navbar-dropdown:focus-within .navbar-dropdown-menu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .navbar-dropdown:hover .navbar-dropdown-trigger::after,
  .navbar-dropdown:focus-within .navbar-dropdown-trigger::after {
    transform: translateY(0.12rem) rotate(225deg);
  }

  @media (max-width: 600px) {
    #navbar-title-container {
      width: 100%;
    }

    #navbar-title {
      font-size: 3.25vw;
    }

    #navbar-links {
      display: none;
    }
  }
</style>
